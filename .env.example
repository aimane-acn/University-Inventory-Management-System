# Environment configuration template for local / production setup
# Copy this file to .env for local development with environment variables
DJANGO_SECRET_KEY=your-long-random-secret-key-change-in-production
SECRET_KEY=your-long-random-secret-key-change-in-production
DATABASE_URL=postgresql://username:password@your-host:5432/your-db?sslmode=require
DEBUG=False
ALLOWED_HOSTS=your-app.vercel.app,localhost,127.0.0.1
